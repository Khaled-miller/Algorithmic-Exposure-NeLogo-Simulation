<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="true">
  <code><![CDATA[globals [ peopleLeavePlatform ; to keep count of users that left the platform(simulation)
          violenceLevel ; calculate the percentage of violent users 
          hateSpeechSpread ; overall posted hate speech 
] 

turtles-own [
 opinion              ; the side that the turtle leans to:  0.0 extreme, 0.5 moderate, 1.0 extreme
 radicalization   ; the percentage of how radical a turtle ranging from 0.0 to 1.0 
 support-for-violence   ; Internal and external factor affect violent behaviour: between 0.0 and 1.0
 violence             ; the percentage of violence in turtles: [0.0-0.2] peacful, [0.2-0.5] low (normal anger for example), 0.5 < :aggressive (e.g. property damage), 1.0 :extreme violence
 trust-in-platform    ; the trust of a turtle in the platform: 0.0 to 1.0. If hits 0, turtle dies.
 activity-rate        ; probability of a turtle posting or interacting: 0 to 100. 
 published?           ; becomes true when a turtle pass the activity-rate filter (publishing a post)
 resistance-to-persuasion ;  is a nonlinear parameter (1.5,2,3) representing the agent's resistance to persuasion or (social inertia). it is to calculate the probability that a turtle would shifts its opinion 
]

to setup
  clear-all
  reset-ticks
  set violenceLevel 0
  set peopleLeavePlatform 0
  set hateSpeechSpread 0
  create-turtles population ;slider for setting the population
  ask turtles [
    setup-opinion
    setup-radicalization 
    setup-support-for-violence 
    setup-violence 
    set trust-in-platform 1; turtles start with fully trust of the platform
    setup-activity-rate
    
    let val random-normal 2 0.5  ; the value of 2 is the most common. Other values for resistance-to-persuasion are 1.5 and 3. as the value of resistance-to-persuasion increases, turtles become more reluctant to change their opinion
    if val <= 1.75 
    [ 
      set resistance-to-persuasion 1.5 
    ]
    if val >= 2.5
    [
      set resistance-to-persuasion 3   
    ]
    
    set published? false 
    setup-visuals
    setxy random-xcor random-ycor
    
    

  ]
end

to setup-opinion
    if initial-distribution = "Moderate Majority"  ; case 1: Moderate Majority is a stable society
    [
      set opinion random-normal 0.5 0.3
    ]
    if initial-distribution = "Polarized Majority"  ;case 2 : Polarized Majority
    [
      ifelse random 2 = 0 
        [ set opinion random-normal 0.2 0.3 ] ; left Extremists
        [ set opinion random-normal 0.8 0.3 ] ; right Extremists
    ]
    if initial-distribution = "Random" ; case 3:new platform with no established norms.
    [
      set opinion random-float 1.0
    ]
   
    set opinion max list 0 (min list 1 opinion)
end

to setup-radicalization 
  let extreme 2 * abs (opinion - 0.5)  ; how far is the opinion from moderate 0.5 on the interval [0,1]
  set radicalization extreme ^ 2 ; only very extreme turtels become very radical, but slightly deviation from moderate is not very radical
  set radicalization max list 0  (min list 1 radicalization)
end
  
to setup-support-for-violence
  set support-for-violence radicalization ^ 2 ; support-for-violence is a step comes after cognitive radicalization. high support-for-violence is very rare even among radical turtles
  set support-for-violence max list 0  (min list 1 support-for-violence)
end

to setup-violence 
  set violence min list 1 ( support-for-violence + random-float 0.2 ) ; violence of a turtle is the support-for-violence plus a random number represents influences (peer pressure, oppertunity, substance use) (violent extremism paper)
  set violence max list 0  (min list 1 violence)
end
      
to setup-activity-rate
  set activity-rate (20 + (80 * radicalization)) * trust-in-platform ; activity is driven by radicalization (passion) modulated by trust or willingness to engage
  ; 80 * radicalization is the 'Passion'
  ; we multiply by trust-in-platform so that disappointed turtles or users go silent
  set activity-rate max list 0 (min list 100 activity-rate)
end

to setup-visuals
  set shape "person" 
  set size 2
  
  ( 
    ifelse violence > 0.5 
    [
      set color red
    ]
    violence >= 0.2
    [
      set color orange
    ]
    [
      set color blue
    ]
  )
end


to go
 if ticks = 20000 
  [
    stop
  ]

  if count turtles = 0 [      
    stop ;stop simulationwhen all users leave the platform
  ]   
  ask turtles 
  [
    set published? false
    fd 1
    if  trust-in-platform <= 0   ;if a user has no trust they leave the simulation
    [
      show "A user is leaving!"  ; debuggin in the command center to see if this ever prints when someone leave
      set peopleLeavePlatform peopleLeavePlatform + 1
      die
    ]
    if random 100 < activity-rate  ; check if a turtle can post on the platform (send a post for other turtles to interact with)
    [ 
      set published? true
      set activity-rate (activity-rate * (1 - 0.2)); after agents take an action, their activity decays. decay-factor is 0.2 (delta) 
      algorithmic-filter       
    ]
  ]
  violence-in-population ; function for plotting the percentage of violent population (violence level > 0.5)
  tick
end
    
to algorithmic-filter
  let sender-opinion opinion
  let is-hate-speech? (violence > 0.5) ; hate speech is a post, which a turtle with violent level higher than 0.5 posts it
  if is-hate-speech?  ; if the post was hate speech increase the count 
  [ 
    set hateSpeechSpread hateSpeechSpread + 1
  ]
  
    
  ask other turtles in-radius 5  
  [
    ; we determine if they are on the same side of opinion spectrum (0.5 center).
    ; (A - 0.5) * (B - 0.5) > 0 means they have the same sign (Same Side).
    let my-side (opinion - 0.5)
    let sender-side (sender-opinion - 0.5)
    let same-side? (my-side * sender-side) > 0
    let allowed-to-see? true ; initiate the allowed-to-see variable to true so that the turtle will see the posts even when they have a different opinion
    let difference-in-opinion abs ( opinion - sender-opinion)
    if not same-side? ; if turtles on different sides of the topic 
    [
      if difference-in-opinion > 0.09  ; if the opinion is actually different for case in having turtels with 0.5 opinion (two 0.5 and 0.7 are different even when the same-side? 0>0 is false )
      [
        if random-float 1 >= exposureChance  ; exposureChanse is a slider represents the chance that a turtle has to interact with other turtle from different oppinion
        [ 
          set allowed-to-see? false     ; if the exposureChanse low, turtle will be less likely to interact with other turtle from different opinion. if exposureChanse high, turtle will more likely to interact with other turtle from different opinion
        ]
      ]
    ]
    ifelse allowed-to-see?   ; if reciever can see the post, interact with the post
    [ 
      interact-with-post sender-opinion difference-in-opinion is-hate-speech? 
    ]
    [
      fd 2   ; if the algorithm hided the post, turtle move forword to find other post
    ]
  ]
end
    
to interact-with-post [ sender-opinion difference-in-opinion is-hate-speech? ]
  let my-side (opinion - 0.5)
  let sender-side (sender-opinion - 0.5)
  let same-side? (my-side * sender-side) > 0
  
  
  set activity-rate (activity-rate + 1)  ; activity of the sender neighbors increases
  set activity-rate max list 0  (min list 100 activity-rate)
  
  let neighbor-users other turtles in-radius 5 ; to count the neighbor turtles

  ifelse same-side? and difference-in-opinion < 0.3 ; if both turtles have similar opinions and on the same side . user agrees with this post -> Echo Chamber Effect -> gets more radical. echo chambers environment where beliefs get reinforced.
  [                                 
     
    let probability-reinforce 0
    if any? neighbor-users
    [
      let supporting-neighbors count neighbor-users with [ published? and same-side? ]
      let p-friends (supporting-neighbors / count neighbor-users); calculate 'p' as fraction of suppoters
     set probability-reinforce p-friends ^ resistance-to-persuasion ;nonlinear probability of a user changing their opinion so it takes a lot of turtels from the same side to push me to extremes
    ]
    if random-float 1.0 < probability-reinforce ; chance to change opinion
      [
        ifelse opinion < 0.5
         [ set opinion opinion - 0.01 ] ; move left
         [ set opinion opinion + 0.01 ] ; move right
       set opinion max list 0  (min list 1 opinion)
       setup-radicalization
       setup-support-for-violence
       setup-violence
       set trust-in-platform trust-in-platform + 0.005  ; gain trust
       ]
  ]
  
  [
    ;EXPOSURE TO OPPOSING VIEWS
    
    let probability-change 0   ; we calculate probability of cahnging opinion 
    if any? neighbor-users
    [ 
      let number-opposing-turtles count neighbor-users with [ published? and not same-side? ] 
      let p (number-opposing-turtles / count neighbor-users)   
      set probability-change p ^ resistance-to-persuasion 
    ]
    if random-float 1.0 < probability-change 
    [
      
        ifelse (radicalization > 0.25) ; threshold: Users with opinion < 0.25 or > 0.75 os that only radicals backfire
          [ 
            ifelse opinion < 0.5
            [ 
              set opinion opinion - 0.02 ;  user moves toward their oppinion
                                         
            ] 
            [
              set opinion opinion + 0.02 ; user moves toward their oppinion
                                         
            ]
            set opinion max list 0  (min list 1 opinion)
            setup-radicalization
            setup-support-for-violence
            setup-violence
            set trust-in-platform (trust-in-platform + 0.005) 
         ]
         [ 
            set opinion (opinion + ((sender-opinion - opinion) * 0.1)) ; if moderate, seeing a different view might pull user slightly towards it (tolerance)
            set opinion max list 0  (min list 1 opinion)                  
            setup-radicalization
            setup-support-for-violence
            setup-violence
            set trust-in-platform (trust-in-platform - 0.005) ;moderates lose trust after discomfort
      ]
    ]
  ]
  

 set opinion max list 0  (min list 1 opinion)
 set radicalization max list 0  (min list 1 radicalization)
 set support-for-violence max list 0  (min list 1 support-for-violence)
 set violence max list 0  (min list 1 violence)
 set trust-in-platform max list 0  (min list 1 trust-in-platform)
 set activity-rate max list 0  (min list 100 activity-rate)
      
setup-visuals
end

          
        
                
    
to violence-in-population  ; for the plot
   if count turtles > 0 
  [
   set violenceLevel (count turtles with [violence > 0.5] / count turtles) * 100
 ]
end


    
    ]]></code>
  <widgets>
    <view x="413" wrappingAllowedX="true" y="5" frameRate="30.0" minPycor="-40" height="733" showTickCounter="true" patchSize="9.0" fontSize="10" wrappingAllowedY="true" width="733" tickCounterLabel="ticks" maxPycor="40" updateMode="1" maxPxcor="40" minPxcor="-40"></view>
    <slider x="0" step="10" y="55" max="1000" width="250" display="population" height="50" min="0" direction="Horizontal" default="500.0" variable="population"></slider>
    <slider x="0" step="0.1" y="110" max="1" width="250" display="exposureChance" height="50" min="0" direction="Horizontal" default="0.4" variable="exposureChance"></slider>
    <button x="70" y="10" height="40" disableUntilTicks="false" forever="true" kind="Observer" width="55">go</button>
    <button x="5" y="10" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="60">setup</button>
    <monitor x="105" precision="17" y="250" height="60" fontSize="11" width="100" display="peopleLeavePlatform">population - count turtles</monitor>
    <monitor x="210" precision="17" y="445" height="60" fontSize="11" width="100" display="resistance3">count turtles with [ resistance-to-persuasion = 3 ]</monitor>
    <monitor x="0" precision="17" y="445" height="60" fontSize="11" width="100" display="resistance1.5">count turtles with [ resistance-to-persuasion = 1.5 ]</monitor>
    <monitor x="105" precision="17" y="445" height="60" fontSize="11" width="100" display="resistance2">count turtles with [ resistance-to-persuasion = 2 ]</monitor>
    <monitor x="210" precision="17" y="380" height="60" fontSize="11" width="100" display="red">count turtles with [ color = red ]</monitor>
    <monitor x="105" precision="17" y="380" height="60" fontSize="11" width="100" display="orange">count turtles with [color = orange ]</monitor>
    <monitor x="210" precision="17" y="315" height="60" fontSize="11" width="100">mean [radicalization] of turtles</monitor>
    <monitor x="210" precision="17" y="250" height="60" fontSize="11" width="100">hateSpeechSpread</monitor>
    <monitor x="105" precision="17" y="315" height="60" fontSize="11" width="100">mean [opinion] of turtles</monitor>
    <monitor x="0" precision="17" y="315" height="60" fontSize="11" width="100" display="violencePercentage"><![CDATA[count turtles with [violence > 0.5] / count turtles * 100]]></monitor>
    <monitor x="0" precision="17" y="380" height="60" fontSize="11" width="100" display="blue">count turtles with [ color = blue ]</monitor>
    <monitor x="0" precision="17" y="250" height="60" fontSize="11" width="100" display="Users">count turtles</monitor>
    <chooser x="5" y="170" height="60" variable="initial-distribution" current="1" width="250" display="initial-distribution">
      <choice type="string" value="Moderate Majority"></choice>
      <choice type="string" value="Polarized Majority"></choice>
      <choice type="string" value="Random"></choice>
    </chooser>
    <plot x="5" autoPlotX="true" yMax="10.0" autoPlotY="true" y="515" xMin="0.0" height="175" legend="false" xMax="10.0" yMin="0.0" width="230" display="populationViolence">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="violenceLevel" color="-5298144" legend="true">
        <setup></setup>
        <update>plot violenceLevel</update>
      </pen>
    </plot>
  </widgets>
  <info>## WHAT IS IT?

