    <shape name="computer server" rotatable="false" editableColorIndex="0">
      <rectangle endX="225" startY="30" marked="true" color="-1920102913" endY="270" startX="75" filled="true"></rectangle>
      <line endX="210" startY="30" marked="false" color="255" endY="195" startX="210"></line>
